ai_note = "El Director de IA adapta la partida a tu forma de jugar. Se puede apagar en Opciones: «Adaptación con IA»."
audio_title = "Música y efectos de sonido"
audio_lines = PackedStringArray("Música de las pantallas y los jefes: Juhani Junkala, «15 Melodic RPG Chiptunes» (CC0, opengameart.org)", "«Treacherous path loop» (CC0, opengameart.org; autoría sin documentar en el proyecto)", "Efectos de combate y magia: «RPG Sound Pack» de artisticdude (CC0, opengameart.org)", "Golpes, salto y pasos: «RPG Sounds» e «Interface Sounds» de Kenney (CC0, kenney.nl)", "Espadas y choques: «20 Sword Sound Effects» de StarNinjas (CC0, opengameart.org)", "Graznidos de los patos: sintetizados para este juego", "Sonido ambiente (el viento de los finales): generado por el propio juego, sin archivos de terceros")
fonts_title = "Tipografías"
