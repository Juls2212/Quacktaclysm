script = ExtResource("1_credits")
game_title = "QUACKTACLYSM"
tagline = "Un cuento de patos, almas y una profecía"
masthead = "EDICIÓN ESPECIAL · ÚLTIMO NÚMERO ANTES DEL FIN"
developers_title = "Equipo"
developers = PackedStringArray("Juliana Peñafiel", "Laura Escobar")
