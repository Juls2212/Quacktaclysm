class_name AmbientSlot
extends Resource
## One ambient sound of the game (Phase 15t), a slot of default_audio_events.tres: the cold wind of the endings. It does not loop one short sample
## on a timer: it plays soft GUSTS that fade in and out and overlap a little, each with its own random pitch, volume and start point, so nothing
## repeats the same way twice. Every number is here, so the mix is retuned without touching any code.
##
## To replace the sound with a real recording: copy the file into frontend/audio/sfx/ and write its name in `file` (one path per slot).
## An empty `file` plays the wind the game generates by code (filtered noise). Every file added needs its source and license written in
## the credits resource (default_credits_content.tres).

@export var id: StringName = &""
## A file of frontend/audio/sfx ("" = the wind generated by code).
@export var file: String = ""
## Level of a gust relative to AudioDirector.SFX_DB: well under the music, the voices and the effects.
@export_range(-50.0, -6.0, 0.5, "suffix:dB") var volume_db: float = -27.0
## Each gust is this much louder or quieter, at random (+/-).
@export_range(0.0, 8.0, 0.5, "suffix:dB") var volume_jitter_db: float = 2.5
@export_range(0.25, 2.0, 0.01) var pitch_min: float = 0.85
@export_range(0.25, 2.0, 0.01) var pitch_max: float = 1.1
## Low-pass of the sound: the generated wind is made with it, a file goes through a filter on its own bus.
@export_range(200.0, 20000.0, 10.0, "suffix:Hz") var lowpass_hz: float = 700.0
## Seconds a gust takes to rise and to die away (the longer, the less it is noticed).
@export_range(0.5, 8.0, 0.1, "suffix:s") var fade_in_seconds: float = 3.0
@export_range(0.5, 8.0, 0.1, "suffix:s") var fade_out_seconds: float = 3.5
## Seconds one gust lasts in all (fades included).
@export_range(3.0, 20.0, 0.5, "suffix:s") var gust_seconds: float = 8.0
## Seconds between the starts of two gusts, at random between the two (they may overlap while a gust is still fading).
@export_range(1.0, 30.0, 0.5, "suffix:s") var interval_min_seconds: float = 4.0
@export_range(1.0, 30.0, 0.5, "suffix:s") var interval_max_seconds: float = 9.0
## The gust starts at a random point of the stream, up to this many seconds in.
@export_range(0.0, 10.0, 0.1, "suffix:s") var start_offset_max_seconds: float = 3.0
## Gusts that may sound at once.
@export_range(1, 4, 1) var max_voices: int = 2
## How much the slot follows the music duck of the voices and the story scenes (0 = not at all, 1 = as much as the music).
@export_range(0.0, 1.0, 0.05) var follow_duck: float = 0.6
@export_group("Generated wind")
@export_range(3.0, 12.0, 0.5, "suffix:s") var generated_seconds: float = 8.0
@export_range(4000, 22050, 1, "suffix:Hz") var generated_rate: int = 11025
@export_multiline var note: String = ""


## The plan of one gust, from a random generator: {volume_db, pitch, offset, gap} (the tests read it).
func plan(rng: RandomNumberGenerator) -> Dictionary:
	return {
		"volume_db": volume_db + rng.randf_range(-volume_jitter_db, volume_jitter_db),
		"pitch": rng.randf_range(pitch_min, maxf(pitch_min, pitch_max)),
		"offset": rng.randf_range(0.0, start_offset_max_seconds),
		"gap": rng.randf_range(interval_min_seconds, maxf(interval_min_seconds, interval_max_seconds)),
	}


## The envelope (0 to 1) of a gust `t` seconds in, of `length` seconds in all.
func envelope(t: float, length: float) -> float:
	var rise: float = clampf(t / maxf(fade_in_seconds, 0.01), 0.0, 1.0)
	var fall: float = clampf((length - t) / maxf(fade_out_seconds, 0.01), 0.0, 1.0)
	return smoothstep(0.0, 1.0, minf(rise, fall))


## The wind made by code: filtered noise with slow swells, seamless when it loops. Cheap: a few tens of thousands of samples.
func generate_wind() -> AudioStreamWAV:
	var rate: int = generated_rate
	var count: int = int(generated_seconds * rate)
	var rng := RandomNumberGenerator.new()
	rng.seed = 1507
	var alpha: float = clampf(TAU * lowpass_hz / rate / (1.0 + TAU * lowpass_hz / rate), 0.001, 1.0)
	var raw := PackedFloat32Array()
	raw.resize(count)
	var a: float = 0.0
	var b: float = 0.0
	for i in count:
		var t: float = float(i) / rate
		var swell: float = 0.55 + 0.3 * sin(t * TAU * 0.11) + 0.15 * sin(t * TAU * 0.29 + 1.3)
		a += alpha * (rng.randf_range(-1.0, 1.0) - a)
		b += alpha * (a - b)
		raw[i] = b * swell
	# Seamless loop: the start melts in from the tail that is cut off, so the end flows into the beginning.
	var blend: int = mini(rate, count / 4)
	for i in blend:
		var k: float = float(i) / blend
		raw[i] = raw[count - blend + i] * (1.0 - k) + raw[i] * k
	var peak: float = 0.0001
	for v in raw:
		peak = maxf(peak, absf(v))
	var bytes := PackedByteArray()
	bytes.resize((count - blend) * 2)
	for i in count - blend:
		bytes.encode_s16(i * 2, int(clampf(raw[i] / peak * 0.8, -1.0, 1.0) * 32767.0))
	var stream := AudioStreamWAV.new()
	stream.format = AudioStreamWAV.FORMAT_16_BITS
	stream.mix_rate = rate
	stream.stereo = false
	stream.data = bytes
	stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
	stream.loop_begin = 0
	stream.loop_end = count - blend
	return stream
