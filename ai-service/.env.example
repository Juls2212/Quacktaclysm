# Copy this file to ai-service/.env on YOUR laptop and fill it in. Never commit .env, never share it by chat.
# Secret: your own OpenAI API key (only needed when AI_SERVICE_MODE=openai).
OPENAI_API_KEY=
# Model name to call (only needed in openai mode); pick one available to your OpenAI account. Not hardcoded in the code.
OPENAI_MODEL=
# mock = deterministic local rules, no network | openai = real call to OpenAI (falls back to mock if key/model are empty)
AI_SERVICE_MODE=mock
# Address the service listens on (the game expects http://127.0.0.1:8000 by default).
AI_SERVICE_HOST=127.0.0.1
# Port the service listens on.
AI_SERVICE_PORT=8000
# Seconds to wait for OpenAI before answering 504 (positive number).
OPENAI_TIMEOUT_SECONDS=8
