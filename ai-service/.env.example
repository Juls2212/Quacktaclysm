# Copy to .env (never commit .env) and fill in the values.
# Secret: your OpenAI API key (only needed when AI_SERVICE_MODE=openai).
OPENAI_API_KEY=
# Model name to use (only needed in openai mode). It is not hardcoded anywhere in the code.
OPENAI_MODEL=
# mock = deterministic rules, no network | openai = real call to OpenAI
AI_SERVICE_MODE=mock
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
OPENAI_TIMEOUT_SECONDS=8
